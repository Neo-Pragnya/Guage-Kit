---
import { getCollection } from "astro:content";
import Glyph from "../components/Glyph.astro";
import GaugeHero from "../components/GaugeHero.astro";
import Layout from "../components/Layout.astro";
import { DOC_NAV, DOC_TITLES, FEATURES, STATS, docHref, site } from "../lib/site";

const base = import.meta.env.BASE_URL;
const docs = await getCollection("docs");
const byId = new Map(docs.map((d) => [d.id, d]));
const titleOf = (id: string) =>
  byId.get(id)?.data.title ?? DOC_TITLES[id] ?? (id.split("/").at(-1) ?? id).replace(/[-_]/g, " ");
const DEMOS = [
  { file: "support-assistant-v1-vs-v2.html", title: "RAG assistant, v1 → v2", verdict: "PASS", text: "Faithfulness, retrieval and judged correctness with paired significance tests: what really improved." },
  { file: "support-assistant-v1.html", title: "RAG assistant v1", verdict: "BLOCK", text: "The version that invented details: unsupported claims, per sample, with the gate that stopped it." },
  { file: "support-agent.html", title: "Tool-using agent", verdict: "BLOCK", text: "Tool choice, arguments and trajectory, scored by Guage Kit and by Ananke's evaluators." },
  { file: "intent-classifier.html", title: "Intent classifier", verdict: "BLOCK", text: "Accuracy, macro-F1, kappa, a confusion matrix and a reliability diagram for calibration." },
];
const href = (h: string) => (/^https?:/.test(h) ? h : `${base}${h.replace(/^\//, "")}`);
---

<Layout title={site.name}>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow" data-reveal>{site.eyebrow}</p>
      <h1 data-reveal style="--d: .05s">
        <span class="h1-lead" data-particles>{site.headline}</span>
        {site.highlight && <span class="hl">{site.highlight}</span>}
      </h1>
      <p class="lede" data-reveal style="--d: .1s">{site.lede}</p>
      <div class="hero-actions" data-reveal style="--d: .15s">
        {
          site.ctas.map((c, i) => (
            <a class:list={["btn", "ants", { ghost: i > 0 }]} data-magnetic href={href(c.href)} style="--mk-ants: var(--coral)">
              {c.label}
            </a>
          ))
        }
      </div>
      {site.install && <div class="install-line" data-reveal style="--d: .2s"><span>$ {site.install}</span></div>}
    </div>
    <GaugeHero />
  </section>

  {
    STATS.length > 0 && (
      <div class="stats">
        {STATS.map((s, i) => (
          <div class={`card stat t-${s.tint}`} data-tilt data-reveal style={`--d:${i * 0.05}s`}>
            <strong data-countup>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    )
  }

  <h2 data-reveal>Open a real report</h2>
  <p data-reveal>Generated by <code>guage demo</code>: three systems around a fictional notes app, evaluated offline. Each is one
  self-contained HTML file.</p>
  <div class="demo-grid">
    {
      DEMOS.map((d, i) => (
        <a class="card demo-card" href={`${base}demo/${d.file}`} data-reveal style={`--d:${i * 0.05}s`}>
          <span class:list={["verdict", d.verdict === "PASS" ? "v-pass" : "v-block"]}><i></i>{d.verdict}</span>
          <strong style="display:block;margin:8px 0 4px">{d.title}</strong>
          <p style="margin:0">{d.text}</p>
        </a>
      ))
    }
  </div>

  <h2 data-reveal>In your terminal and your CI</h2>
  <p data-reveal>Real output: the fixture project from the acceptance suite, then the demo's two assistant versions.</p>
  <img class="terminal-svg" data-reveal src={`${base}terminal.svg`} width="860" height="410" alt="A terminal session: guage run gates faithfulness and recall@3 and passes; guage compare shows which metrics improved between two versions, with Holm-corrected p-values." />

  <h2 data-reveal>What's inside</h2>
  <div class="grid-cards">
    {
      FEATURES.map((f, i) => (
        <a class={`card feature t-${f.tint}`} href={href(f.href)} data-tilt data-reveal style={`--d:${Math.min(i * 0.05, 0.3)}s`}>
          <Glyph shapes={f.shapes} tint={f.tint} />
          <strong>{f.title}</strong>
          <p>{f.text}</p>
        </a>
      ))
    }
  </div>

  <h2 data-reveal>Browse the documentation</h2>
  <div class="grid-cards">
    {
      DOC_NAV.map((section) => (
        <section class={`card t-${section.tint}`} data-reveal>
          <p class="sidebar-heading">
            <Glyph shapes={section.shapes} tint={section.tint} class="" />
            {section.section}
          </p>
          <ul style="margin:0;padding-left:18px">
            {section.items
              .filter((id) => byId.has(id))
              .map((id) => (
                <li>
                  <a href={docHref(base, id)}>{id === "index" ? "Overview" : titleOf(id)}</a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
