# Keep this list narrow: hatch builds from what git does not ignore, so a broad pattern silently drops package files
# (tests/test_docs.py fails if any file under src/ is ignored).

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
.python-version

# Tools and caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# Secrets and local settings
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store

# Guage Kit working state and generated output
.guage/
.ananke/
/reports/
/guage-demo/
/scan-report/
/trivy-report.json
/trivy-results.sarif
.acceptance-venv/
acceptance/report/
acceptance/fixtures/projects/*/reports/

# Astro website
website/node_modules/
website/dist/
website/.astro/
website/public/demo/
website/public/readme/
